; NOTE: Assertions have been autogenerated by utils/update_test_checks.py UTC_ARGS: --version 6
; RUN: opt < %s -instcombine -S | FileCheck %s

; Check that InstCombine folds bitwise and/or of fcmp instructions with matching
; or swapped operands according to their 4-bit predicate masks.

target datalayout = "e-m:e-p:32:32-i1:32-i8:32-i16:32-i32:32-i64:64-f16:32-f32:32-f64:64-n8:16:32:64"
target triple = "dxil-ms-dx"

define i1 @or_ord_oeq(float %x, float %y) {
; CHECK-LABEL: define i1 @or_ord_oeq(
; CHECK-SAME: float [[X:%.*]], float [[Y:%.*]]) {
; CHECK-NEXT:    [[TMP1:%.*]] = fcmp ord float [[X]], [[Y]]
; CHECK-NEXT:    ret i1 [[TMP1]]
;
  %c0 = fcmp ord float %x, %y
  %c1 = fcmp oeq float %x, %y
  %r = or i1 %c0, %c1
  ret i1 %r
}

define i1 @or_uno_ogt_swapped(float %x, float %y) {
; CHECK-LABEL: define i1 @or_uno_ogt_swapped(
; CHECK-SAME: float [[X:%.*]], float [[Y:%.*]]) {
; CHECK-NEXT:    [[TMP1:%.*]] = fcmp ult float [[X]], [[Y]]
; CHECK-NEXT:    ret i1 [[TMP1]]
;
  %c0 = fcmp uno float %x, %y
  %c1 = fcmp ogt float %y, %x
  %r = or i1 %c0, %c1
  ret i1 %r
}

define i1 @or_ord_uno(float %x, float %y) {
; CHECK-LABEL: define i1 @or_ord_uno(
; CHECK-SAME: float [[X:%.*]], float [[Y:%.*]]) {
; CHECK-NEXT:    ret i1 true
;
  %c0 = fcmp ord float %x, %y
  %c1 = fcmp uno float %x, %y
  %r = or i1 %c0, %c1
  ret i1 %r
}

define i1 @and_ole_ole_swapped(float %x, float %y) {
; CHECK-LABEL: define i1 @and_ole_ole_swapped(
; CHECK-SAME: float [[X:%.*]], float [[Y:%.*]]) {
; CHECK-NEXT:    [[TMP1:%.*]] = fcmp oeq float [[X]], [[Y]]
; CHECK-NEXT:    ret i1 [[TMP1]]
;
  %c0 = fcmp ole float %x, %y
  %c1 = fcmp ole float %y, %x
  %r = and i1 %c0, %c1
  ret i1 %r
}

define i1 @and_ogt_olt(float %x, float %y) {
; CHECK-LABEL: define i1 @and_ogt_olt(
; CHECK-SAME: float [[X:%.*]], float [[Y:%.*]]) {
; CHECK-NEXT:    ret i1 false
;
  %c0 = fcmp ogt float %x, %y
  %c1 = fcmp olt float %x, %y
  %r = and i1 %c0, %c1
  ret i1 %r
}
