; NOTE: Assertions have been autogenerated by utils/update_test_checks.py UTC_ARGS: --version 6
; RUN: opt < %s -hlsl-dxilload -indvars -S | FileCheck %s

; Check that ScalarEvolution does not use non-deterministic floating-point
; constant folding to compute exhaustive loop trip counts, so IndVarSimplify
; keeps the loop bounds. The cases are a floating-point intrinsic in the loop
; and as the start value of the loop, operations and casts that produce NaN bit
; patterns, and an operation with fast-math flags.

target datalayout = "e-m:e-p:32:32-i1:32-i8:32-i16:32-i32:32-i64:64-f16:32-f32:32-f64:64-n8:16:32:64"
target triple = "dxil-ms-dx"

define i32 @dxil_sin_trip_count() {
; CHECK-LABEL: define i32 @dxil_sin_trip_count() {
; CHECK-NEXT:  [[ENTRY:.*]]:
; CHECK-NEXT:    br label %[[LOOP:.*]]
; CHECK:       [[LOOP]]:
; CHECK-NEXT:    [[IV:%.*]] = phi i32 [ 0, %[[ENTRY]] ], [ [[IV_NEXT:%.*]], %[[LATCH:.*]] ]
; CHECK-NEXT:    [[FV:%.*]] = phi float [ 0x3FB99999A0000000, %[[ENTRY]] ], [ [[FV_NEXT:%.*]], %[[LATCH]] ]
; CHECK-NEXT:    [[BOUND:%.*]] = icmp ult i32 [[IV]], 128
; CHECK-NEXT:    br i1 [[BOUND]], label %[[BODY:.*]], label %[[EXIT:.*]]
; CHECK:       [[BODY]]:
; CHECK-NEXT:    [[S:%.*]] = call float @dx.op.unary.f32(i32 13, float [[FV]])
; CHECK-NEXT:    [[STOP:%.*]] = fcmp oeq float [[S]], 0x3FD68BA980000000
; CHECK-NEXT:    br i1 [[STOP]], label %[[EXIT]], label %[[LATCH]]
; CHECK:       [[LATCH]]:
; CHECK-NEXT:    [[FV_NEXT]] = fadd float [[FV]], 0x3F8A9FBE80000000
; CHECK-NEXT:    [[IV_NEXT]] = add nuw nsw i32 [[IV]], 1
; CHECK-NEXT:    br label %[[LOOP]]
; CHECK:       [[EXIT]]:
; CHECK-NEXT:    [[RES:%.*]] = phi i32 [ [[IV]], %[[LOOP]] ], [ [[IV]], %[[BODY]] ]
; CHECK-NEXT:    ret i32 [[RES]]
;
entry:
  br label %loop

loop:
  %iv = phi i32 [ 0, %entry ], [ %iv.next, %latch ]
  %fv = phi float [ 0x3FB99999A0000000, %entry ], [ %fv.next, %latch ]
  %bound = icmp ult i32 %iv, 128
  br i1 %bound, label %body, label %exit

body:
  %s = call float @dx.op.unary.f32(i32 13, float %fv)
  %stop = fcmp oeq float %s, 0x3FD68BA980000000
  br i1 %stop, label %exit, label %latch

latch:
  %fv.next = fadd float %fv, 0x3F8A9FBE80000000
  %iv.next = add nuw nsw i32 %iv, 1
  br label %loop

exit:
  %res = phi i32 [ %iv, %loop ], [ %iv, %body ]
  ret i32 %res
}

define i32 @nan_propagate_bitcast() {
; CHECK-LABEL: define i32 @nan_propagate_bitcast() {
; CHECK-NEXT:  [[ENTRY:.*]]:
; CHECK-NEXT:    br label %[[LOOP:.*]]
; CHECK:       [[LOOP]]:
; CHECK-NEXT:    [[IV:%.*]] = phi i32 [ 0, %[[ENTRY]] ], [ [[IV_NEXT:%.*]], %[[LATCH:.*]] ]
; CHECK-NEXT:    [[BOUND:%.*]] = icmp ult i32 [[IV]], 128
; CHECK-NEXT:    br i1 [[BOUND]], label %[[BODY:.*]], label %[[EXIT:.*]]
; CHECK:       [[BODY]]:
; CHECK-NEXT:    [[NAN_BITS:%.*]] = add nuw nsw i32 [[IV]], -4194303
; CHECK-NEXT:    [[NAN_IN:%.*]] = bitcast i32 [[NAN_BITS]] to float
; CHECK-NEXT:    [[NAN_OUT:%.*]] = fmul float [[NAN_IN]], 3.000000e+00
; CHECK-NEXT:    [[OUT_BITS:%.*]] = bitcast float [[NAN_OUT]] to i32
; CHECK-NEXT:    [[STOP:%.*]] = icmp eq i32 [[OUT_BITS]], 2143289347
; CHECK-NEXT:    br i1 [[STOP]], label %[[EXIT]], label %[[LATCH]]
; CHECK:       [[LATCH]]:
; CHECK-NEXT:    [[IV_NEXT]] = add nuw nsw i32 [[IV]], 1
; CHECK-NEXT:    br label %[[LOOP]]
; CHECK:       [[EXIT]]:
; CHECK-NEXT:    [[RES:%.*]] = phi i32 [ [[IV]], %[[LOOP]] ], [ [[IV]], %[[BODY]] ]
; CHECK-NEXT:    ret i32 [[RES]]
;
entry:
  br label %loop

loop:
  %iv = phi i32 [ 0, %entry ], [ %iv.next, %latch ]
  %bound = icmp ult i32 %iv, 128
  br i1 %bound, label %body, label %exit

body:
  %nan.bits = add nsw i32 %iv, -4194303
  %nan.in = bitcast i32 %nan.bits to float
  %nan.out = fmul float %nan.in, 3.000000e+00
  %out.bits = bitcast float %nan.out to i32
  %stop = icmp eq i32 %out.bits, 2143289347
  br i1 %stop, label %exit, label %latch

latch:
  %iv.next = add nuw nsw i32 %iv, 1
  br label %loop

exit:
  %res = phi i32 [ %iv, %loop ], [ %iv, %body ]
  ret i32 %res
}

