; NOTE: Assertions have been autogenerated by utils/update_test_checks.py UTC_ARGS: --version 6
; RUN: opt < %s -instsimplify -S | FileCheck %s

; Check that constant folding of floating-point operations follows the
; function's "fp32-denorm-mode" for float denormals, and keeps double denormals.

target datalayout = "e-m:e-p:32:32-i1:32-i8:32-i16:32-i32:32-i64:64-f16:32-f32:32-f64:64-n8:16:32:64"
target triple = "dxil-ms-dx"

define float @fmul_denormal_output_preserve() #0 {
; CHECK-LABEL: define float @fmul_denormal_output_preserve(
; CHECK-SAME: ) #[[ATTR0:[0-9]+]] {
; CHECK-NEXT:    ret float 0x3800000000000000
;
  %r = fmul float 0x3810000000000000, 5.000000e-01
  ret float %r
}

define float @fmul_denormal_output_ftz() #1 {
; CHECK-LABEL: define float @fmul_denormal_output_ftz(
; CHECK-SAME: ) #[[ATTR1:[0-9]+]] {
; CHECK-NEXT:    ret float 0.000000e+00
;
  %r = fmul float 0x3810000000000000, 5.000000e-01
  ret float %r
}

define float @fmul_denormal_input_ftz() #1 {
; CHECK-LABEL: define float @fmul_denormal_input_ftz(
; CHECK-SAME: ) #[[ATTR1]] {
; CHECK-NEXT:    ret float 0.000000e+00
;
  %r = fmul float 0x3800000000000000, 2.000000e+00
  ret float %r
}

define float @fmul_denormal_output_any() #2 {
; CHECK-LABEL: define float @fmul_denormal_output_any(
; CHECK-SAME: ) #[[ATTR2:[0-9]+]] {
; CHECK-NEXT:    ret float 0x3800000000000000
;
  %r = fmul float 0x3810000000000000, 5.000000e-01
  ret float %r
}

define double @fmul_double_denormal_output_ftz() #1 {
; CHECK-LABEL: define double @fmul_double_denormal_output_ftz(
; CHECK-SAME: ) #[[ATTR1]] {
; CHECK-NEXT:    ret double 0x8000000000000
;
  %r = fmul double 0x0010000000000000, 5.000000e-01
  ret double %r
}

define i1 @fcmp_denormal_input_preserve() #0 {
; CHECK-LABEL: define i1 @fcmp_denormal_input_preserve(
; CHECK-SAME: ) #[[ATTR0]] {
; CHECK-NEXT:    ret i1 true
;
  %r = fcmp une float 0x3800000000000000, 0.000000e+00
  ret i1 %r
}

define i1 @fcmp_denormal_input_ftz() #1 {
; CHECK-LABEL: define i1 @fcmp_denormal_input_ftz(
; CHECK-SAME: ) #[[ATTR1]] {
; CHECK-NEXT:    ret i1 false
;
  %r = fcmp une float 0x3800000000000000, 0.000000e+00
  ret i1 %r
}

define i1 @fcmp_denormal_input_any() #2 {
; CHECK-LABEL: define i1 @fcmp_denormal_input_any(
; CHECK-SAME: ) #[[ATTR2]] {
; CHECK-NEXT:    ret i1 true
;
  %r = fcmp une float 0x3800000000000000, 0.000000e+00
  ret i1 %r
}

attributes #0 = { "fp32-denorm-mode"="preserve" }
attributes #1 = { "fp32-denorm-mode"="ftz" }
attributes #2 = { "fp32-denorm-mode"="any" }
