; NOTE: Assertions have been autogenerated by utils/update_test_checks.py UTC_ARGS: --version 6
; RUN: opt < %s -instcombine -S | FileCheck %s

; Check that InstCombine does not fold a select of a casted value and a constant
; into a min/max when round-trip casting does not reproduce the original
; constant.

target datalayout = "e-m:e-p:32:32-i1:32-i8:8-i16:16-i32:32-i64:64-f16:16-f32:32-f64:64-n8:16:32:64"
target triple = "dxil-ms-dx"

define i32 @zext_ult_no_roundtrip(i16 %x) {
; CHECK-LABEL: define i32 @zext_ult_no_roundtrip(
; CHECK-SAME: i16 [[X:%.*]]) {
; CHECK-NEXT:    [[CMP:%.*]] = icmp ult i16 [[X]], 15366
; CHECK-NEXT:    [[EXT:%.*]] = zext i16 [[X]] to i32
; CHECK-NEXT:    [[SEL:%.*]] = select i1 [[CMP]], i32 [[EXT]], i32 80902
; CHECK-NEXT:    ret i32 [[SEL]]
;
  %cmp = icmp ult i16 %x, 15366
  %ext = zext i16 %x to i32
  %sel = select i1 %cmp, i32 %ext, i32 80902
  ret i32 %sel
}

define <2 x i8> @trunc_slt_vec_undef(<2 x i32> %x) {
; CHECK-LABEL: define <2 x i8> @trunc_slt_vec_undef(
; CHECK-SAME: <2 x i32> [[X:%.*]]) {
; CHECK-NEXT:    [[CMP:%.*]] = icmp slt <2 x i32> [[X]], <i32 5, i32 0>
; CHECK-NEXT:    [[TR:%.*]] = trunc <2 x i32> [[X]] to <2 x i8>
; CHECK-NEXT:    [[SEL:%.*]] = select <2 x i1> [[CMP]], <2 x i8> [[TR]], <2 x i8> <i8 5, i8 undef>
; CHECK-NEXT:    ret <2 x i8> [[SEL]]
;
  %cmp = icmp slt <2 x i32> %x, <i32 5, i32 0>
  %tr = trunc <2 x i32> %x to <2 x i8>
  %sel = select <2 x i1> %cmp, <2 x i8> %tr, <2 x i8> <i8 5, i8 undef>
  ret <2 x i8> %sel
}
