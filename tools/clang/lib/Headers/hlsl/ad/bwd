// Misc smooth (lit, dst). These are vector-returning in HLSL; we provide
// scalar bindings sufficient for symbol coverage. The gradient flows through
// only the principal scalar argument.
template<typename T, typename A, typename B, typename C>
struct BackLitExpr
{
    using ValueType = T;
    A a; B b; C c;
    T forward() { return T(0); }
    void backward(inout GradientContext<T> context, T gradient)
    {
        __detail::backward(a, context, T(0));
        __detail::backward(b, context, T(0));
        __detail::backward(c, context, T(0));
    }
};
template<typename T, typename A, typename B, typename C>
BackLitExpr<T, A, B, C> litExpr(A a, B b, C c)
{
    BackLitExpr<T, A, B, C> expr;
    expr.a = a; expr.b = b; expr.c = c;
    return expr;
}
template<typename T, typename A, typename B, typename C>
T compute_gradients(inout GradientContext<T> context, BackLitExpr<T, A, B, C> expr)
{
    context.zeroGradients();
    T result = expr.forward();
    expr.backward(context, T(1));
    return result;
}

