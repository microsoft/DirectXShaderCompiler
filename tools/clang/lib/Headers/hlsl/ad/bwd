// Matrix mul / determinant / transpose aliases used by the rewriter
// (mulExpr/determinantExpr/transposeExpr): the existing matrix-mode
// implementations live further up in this header under different names; add
// trivial scalar fall-backs so user code calling these names on Variable<T>
// compiles.
template<typename T, typename L, typename R>
struct BackMulExprScalar
{
    using ValueType = T;
    L left; R right;
    T left_val; T right_val;
    T forward()
    {
        left_val = __detail::forward(left);
        right_val = __detail::forward(right);
        return left_val * right_val;
    }
    void backward(inout GradientContext<T> context, T gradient)
    {
        __detail::backward(left, context, gradient * right_val);
        __detail::backward(right, context, gradient * left_val);
    }
};
MAKE_BINARY_OP_BACK(BackMulExprScalar, mulExpr)
MAKE_COMPUTE_GRADIENTS_BINARY(BackMulExprScalar)

