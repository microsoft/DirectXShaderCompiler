; NOTE: Assertions have been autogenerated by utils/update_test_checks.py UTC_ARGS: --version 6
; RUN: opt < %s -indvars -loop-deletion -S | FileCheck %s

; Check that SimplifyIndVar forgets cached SCEV expressions for users of an
; eliminated IV comparison before replacing it with a constant, so subsequent
; loop passes do not read stale inner-loop recurrences after LoopDeletion hoists
; those users and deletes the inner loop.

target datalayout = "e-m:e-p:32:32-i1:32-i8:32-i16:32-i32:32-i64:64-f16:32-f32:32-f64:64-n8:16:32:64"
target triple = "dxil-ms-dx"

; %cmp (j1 >s j2) is folded to true by SimplifyIndVar.
define i32 @forget_icmp_true(i32 %n) {
; CHECK-LABEL: define i32 @forget_icmp_true(
; CHECK-SAME: i32 [[N:%.*]]) {
; CHECK-NEXT:  [[ENTRY:.*]]:
; CHECK-NEXT:    br label %[[OUTER_HEADER:.*]]
; CHECK:       [[OUTER_HEADER]]:
; CHECK-NEXT:    [[OUTER:%.*]] = phi i32 [ 0, %[[ENTRY]] ], [ [[OUTER_NEXT:%.*]], %[[OUTER_LATCH:.*]] ]
; CHECK-NEXT:    [[RES:%.*]] = phi i32 [ 0, %[[ENTRY]] ], [ [[RES_NEXT:%.*]], %[[OUTER_LATCH]] ]
; CHECK-NEXT:    [[LA:%.*]] = add i32 [[N]], 398
; CHECK-NEXT:    [[SEL:%.*]] = select i1 true, i32 [[LA]], i32 [[N]]
; CHECK-NEXT:    br label %[[INNER_EXIT:.*]]
; CHECK:       [[INNER_EXIT]]:
; CHECK-NEXT:    [[SEL_LCSSA:%.*]] = phi i32 [ [[SEL]], %[[OUTER_HEADER]] ]
; CHECK-NEXT:    [[OUTER_EARLY:%.*]] = icmp ult i32 [[OUTER]], [[SEL_LCSSA]]
; CHECK-NEXT:    br i1 [[OUTER_EARLY]], label %[[OUTER_LATCH]], label %[[EXIT:.*]]
; CHECK:       [[OUTER_LATCH]]:
; CHECK-NEXT:    [[RES_NEXT]] = add i32 [[SEL_LCSSA]], [[RES]]
; CHECK-NEXT:    [[OUTER_NEXT]] = add nuw nsw i32 [[OUTER]], 1
; CHECK-NEXT:    [[OUTER_DONE:%.*]] = icmp ult i32 [[OUTER_NEXT]], 1000
; CHECK-NEXT:    br i1 [[OUTER_DONE]], label %[[OUTER_HEADER]], label %[[EXIT]]
; CHECK:       [[EXIT]]:
; CHECK-NEXT:    [[RES_LCSSA:%.*]] = phi i32 [ [[RES]], %[[INNER_EXIT]] ], [ [[RES_NEXT]], %[[OUTER_LATCH]] ]
; CHECK-NEXT:    ret i32 [[RES_LCSSA]]
;
entry:
  br label %outer.header

outer.header:
  %outer = phi i32 [ 0, %entry ], [ %outer.next, %outer.latch ]
  %res = phi i32 [ 0, %entry ], [ %res.next, %outer.latch ]
  %la = add i32 %n, 398
  br label %inner.header

inner.header:
  %j2 = phi i32 [ 2, %outer.header ], [ %j2.next, %inner.latch ]
  %j1 = phi i32 [ 400, %outer.header ], [ %j1.next, %inner.latch ]
  %k = phi i32 [ 5, %outer.header ], [ %k.next, %inner.latch ]
  %cmp = icmp sgt i32 %j1, %j2
  %sel = select i1 %cmp, i32 %la, i32 %n
  %t = add i32 %sel, %k
  %early = icmp eq i32 %t, %n
  br i1 %early, label %inner.exit, label %inner.latch

inner.latch:
  %j1.next = add i32 %j1, 2
  %j2.next = add i32 %j2, 2
  %k.next = add i32 %k, 1
  %inner.done = icmp ult i32 %k.next, 105
  br i1 %inner.done, label %inner.header, label %inner.exit

inner.exit:
  %outer.early = icmp ult i32 %outer, %sel
  br i1 %outer.early, label %outer.latch, label %exit

outer.latch:
  %res.next = add i32 %sel, %res
  %outer.next = add i32 %outer, 1
  %outer.done = icmp ult i32 %outer.next, 1000
  br i1 %outer.done, label %outer.header, label %exit

exit:
  %res.lcssa = phi i32 [ %res, %inner.exit ], [ %res.next, %outer.latch ]
  ret i32 %res.lcssa
}

; %cmp (j1 <s j2) is folded to false by SimplifyIndVar.
