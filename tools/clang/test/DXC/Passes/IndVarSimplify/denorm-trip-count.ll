; NOTE: Assertions have been autogenerated by utils/update_test_checks.py UTC_ARGS: --version 6
; RUN: opt < %s -indvars -S | FileCheck %s

; Check that ScalarEvolution does not evaluate a loop through a float denormal
; when "fp32-denorm-mode" does not say that denormals are kept, so
; IndVarSimplify keeps the loop bound, and that it does when the mode is
; "preserve".

target datalayout = "e-m:e-p:32:32-i1:32-i8:32-i16:32-i32:32-i64:64-f16:32-f32:32-f64:64-n8:16:32:64"
target triple = "dxil-ms-dx"

define i32 @denormal_fmul_any(i32 %stop) #0 {
; CHECK-LABEL: define i32 @denormal_fmul_any(
; CHECK-SAME: i32 [[STOP:%.*]]) #[[ATTR0:[0-9]+]] {
; CHECK-NEXT:  [[ENTRY:.*]]:
; CHECK-NEXT:    br label %[[LOOP:.*]]
; CHECK:       [[LOOP]]:
; CHECK-NEXT:    [[I:%.*]] = phi i32 [ 0, %[[ENTRY]] ], [ [[I_NEXT:%.*]], %[[LATCH:.*]] ]
; CHECK-NEXT:    [[F:%.*]] = phi float [ 0x3820000000000000, %[[ENTRY]] ], [ [[F_NEXT:%.*]], %[[LATCH]] ]
; CHECK-NEXT:    [[F_NEXT]] = fmul float [[F]], 5.000000e-01
; CHECK-NEXT:    [[SCALED:%.*]] = fmul float [[F_NEXT]], 0x47D0000000000000
; CHECK-NEXT:    [[FCMP:%.*]] = fcmp oeq float [[SCALED]], 5.000000e-01
; CHECK-NEXT:    [[SCMP:%.*]] = icmp eq i32 [[I]], [[STOP]]
; CHECK-NEXT:    [[OR_COND:%.*]] = or i1 [[FCMP]], [[SCMP]]
; CHECK-NEXT:    br i1 [[OR_COND]], label %[[EXIT:.*]], label %[[LATCH]]
; CHECK:       [[LATCH]]:
; CHECK-NEXT:    [[I_NEXT]] = add nuw nsw i32 [[I]], 1
; CHECK-NEXT:    [[BOUND:%.*]] = icmp ult i32 [[I_NEXT]], 128
; CHECK-NEXT:    br i1 [[BOUND]], label %[[LOOP]], label %[[EXIT]]
; CHECK:       [[EXIT]]:
; CHECK-NEXT:    [[RES:%.*]] = phi i32 [ [[I]], %[[LOOP]] ], [ [[I_NEXT]], %[[LATCH]] ]
; CHECK-NEXT:    ret i32 [[RES]]
;
entry:
  br label %loop

loop:
  %i = phi i32 [ 0, %entry ], [ %i.next, %latch ]
  %f = phi float [ 0x3820000000000000, %entry ], [ %f.next, %latch ]
  %f.next = fmul float %f, 5.000000e-01
  %scaled = fmul float %f.next, 0x47D0000000000000
  %fcmp = fcmp oeq float %scaled, 5.000000e-01
  br i1 %fcmp, label %exit, label %guard

guard:
  %scmp = icmp eq i32 %i, %stop
  br i1 %scmp, label %exit, label %latch

latch:
  %i.next = add nuw nsw i32 %i, 1
  %bound = icmp ult i32 %i.next, 128
  br i1 %bound, label %loop, label %exit

exit:
  %res = phi i32 [ %i, %loop ], [ %i, %guard ], [ %i.next, %latch ]
  ret i32 %res
}

