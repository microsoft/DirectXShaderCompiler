; NOTE: Assertions have been autogenerated by utils/update_test_checks.py UTC_ARGS: --version 6
; RUN: opt < %s -loop-unroll -reassociate -gvn -dxil-remove-dead-blocks -S | FileCheck %s

; Check that dxil-remove-dead-blocks does not fold the loop exit using a value
; that DxilValueCache computed for %X before reassociate rewrote %X in place.

target datalayout = "e-m:e-p:32:32-i1:32-i8:32-i16:32-i32:32-i64:64-f16:32-f32:32-f64:64-n8:16:32:64"
target triple = "dxil-ms-dx"

declare i1 @dx.break()
declare void @sink(i32)

define void @f(i32 %a, i32 %c, i32 %stop) {
; CHECK-LABEL: define void @f(
; CHECK-SAME: i32 [[A:%.*]], i32 [[C:%.*]], i32 [[STOP:%.*]]) {
; CHECK-NEXT:  [[ENTRY:.*]]:
; CHECK-NEXT:    br label %[[OUTER:.*]]
; CHECK:       [[OUTER]]:
; CHECK-NEXT:    [[I:%.*]] = phi i32 [ 0, %[[ENTRY]] ], [ [[X:%.*]], %[[LATCH:.*]] ]
; CHECK-NEXT:    [[BRK:%.*]] = call i1 @dx.break()
; CHECK-NEXT:    br label %[[BRANCH_MERGE:.*]]
; CHECK:       [[BRANCH_MERGE]]:
; CHECK-NEXT:    [[X]] = add i32 [[I]], 1
; CHECK-NEXT:    [[ROOT:%.*]] = add i32 [[X]], 0
; CHECK-NEXT:    br label %[[INNER:.*]]
; CHECK:       [[INNER]]:
; CHECK-NEXT:    [[S:%.*]] = phi i32 [ 0, %[[BRANCH_MERGE]] ], [ [[S_NEXT:%.*]], %[[INNER]] ]
; CHECK-NEXT:    [[S_NEXT]] = add i32 [[S]], 1
; CHECK-NEXT:    [[SQ:%.*]] = mul i32 [[S_NEXT]], [[S_NEXT]]
; CHECK-NEXT:    [[RX:%.*]] = xor i32 [[ROOT]], [[C]]
; CHECK-NEXT:    [[SUM:%.*]] = add i32 [[SQ]], [[RX]]
; CHECK-NEXT:    [[INNER_DONE:%.*]] = icmp uge i32 [[SUM]], 4
; CHECK-NEXT:    br i1 [[INNER_DONE]], label %[[BODY:.*]], label %[[INNER]]
; CHECK:       [[BODY]]:
; CHECK-NEXT:    call void @sink(i32 [[ROOT]])
; CHECK-NEXT:    [[USER_STOP:%.*]] = icmp eq i32 [[I]], [[STOP]]
; CHECK-NEXT:    br i1 [[USER_STOP]], label %[[EXIT:.*]], label %[[LATCH]]
; CHECK:       [[LATCH]]:
; CHECK-NEXT:    [[BOUND:%.*]] = icmp ult i32 [[X]], 1024
; CHECK-NEXT:    br i1 [[BOUND]], label %[[OUTER]], label %[[EXIT]]
; CHECK:       [[EXIT]]:
; CHECK-NEXT:    ret void
;
entry:
  br label %outer

outer:
  %i = phi i32 [ 0, %entry ], [ %i.next, %latch ]
  br label %branch_cond

branch_cond:
  %brk = call i1 @dx.break()
  br i1 %brk, label %branch_merge, label %branch_else

branch_else:
  br label %branch_merge

branch_merge:
  %p1 = phi i32 [ 0, %branch_cond ], [ %a, %branch_else ]
  %X = add i32 %p1, 1
  %root = add i32 %X, %i
  br label %inner

inner:
  %s = phi i32 [ 0, %branch_merge ], [ %s.next, %inner ]
  %s.next = add i32 %s, 1
  %sq = mul i32 %s.next, %s.next
  %rx = xor i32 %root, %c
  %sum = add i32 %sq, %rx
  %inner_done = icmp uge i32 %sum, 4
  br i1 %inner_done, label %body, label %inner

body:
  call void @sink(i32 %root)
  %user_stop = icmp eq i32 %i, %stop
  br i1 %user_stop, label %exit, label %latch

latch:
  %i.next = add i32 %i, 1
  %bound = icmp ult i32 %i.next, 1024
  br i1 %bound, label %outer, label %exit

exit:
  ret void
}
