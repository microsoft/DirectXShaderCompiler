; NOTE: Assertions have been autogenerated by utils/update_test_checks.py UTC_ARGS: --version 6
; RUN: opt < %s -indvars -S | FileCheck %s

; Check that SimplifyIndVar drops the exact flag from lshr and udiv when the
; substituted dividend is not a multiple of the divisor, and preserves exact
; when the substituted dividend is a multiple of the divisor.

target datalayout = "e-m:e-p:32:32-i1:32-i8:32-i16:32-i32:32-i64:64-f16:32-f32:32-f64:64-n8:16:32:64"
target triple = "dxil-ms-dx"

declare void @use(i32)

; %iv = 16*k + 15 is not divisible by 8, so exact is dropped when (%iv - 7) >> 3
; is folded to %iv >> 3.
define void @drop_exact_lshr() {
; CHECK-LABEL: define void @drop_exact_lshr() {
; CHECK-NEXT:  [[ENTRY:.*]]:
; CHECK-NEXT:    br label %[[LOOP:.*]]
; CHECK:       [[LOOP]]:
; CHECK-NEXT:    [[IV:%.*]] = phi i32 [ 15, %[[ENTRY]] ], [ [[IV_NEXT:%.*]], %[[LOOP]] ]
; CHECK-NEXT:    [[SHR:%.*]] = lshr i32 [[IV]], 3
; CHECK-NEXT:    call void @use(i32 [[SHR]])
; CHECK-NEXT:    [[IV_NEXT]] = add nuw nsw i32 [[IV]], 16
; CHECK-NEXT:    [[DONE:%.*]] = icmp eq i32 [[IV_NEXT]], 527
; CHECK-NEXT:    br i1 [[DONE]], label %[[EXIT:.*]], label %[[LOOP]]
; CHECK:       [[EXIT]]:
; CHECK-NEXT:    ret void
;
entry:
  br label %loop

loop:
  %iv = phi i32 [ 15, %entry ], [ %iv.next, %loop ]
  %aligned = sub nuw nsw i32 %iv, 7
  %shr = lshr exact i32 %aligned, 3
  call void @use(i32 %shr)
  %iv.next = add nuw nsw i32 %iv, 16
  %done = icmp eq i32 %iv.next, 527
  br i1 %done, label %exit, label %loop

exit:
  ret void
}

; %iv = 16*k + 8 is divisible by 8, so exact is preserved when (%iv + 1) >> 3
; is folded to %iv >> 3.
define void @keep_exact_lshr() {
; CHECK-LABEL: define void @keep_exact_lshr() {
; CHECK-NEXT:  [[ENTRY:.*]]:
; CHECK-NEXT:    br label %[[LOOP:.*]]
; CHECK:       [[LOOP]]:
; CHECK-NEXT:    [[IV:%.*]] = phi i32 [ 8, %[[ENTRY]] ], [ [[IV_NEXT:%.*]], %[[LOOP]] ]
; CHECK-NEXT:    [[SHR:%.*]] = lshr exact i32 [[IV]], 3
; CHECK-NEXT:    call void @use(i32 [[SHR]])
; CHECK-NEXT:    [[IV_NEXT]] = add nuw nsw i32 [[IV]], 16
; CHECK-NEXT:    [[DONE:%.*]] = icmp eq i32 [[IV_NEXT]], 520
; CHECK-NEXT:    br i1 [[DONE]], label %[[EXIT:.*]], label %[[LOOP]]
; CHECK:       [[EXIT]]:
; CHECK-NEXT:    ret void
;
entry:
  br label %loop

loop:
  %iv = phi i32 [ 8, %entry ], [ %iv.next, %loop ]
  %unaligned = add nuw nsw i32 %iv, 1
  %shr = lshr exact i32 %unaligned, 3
  call void @use(i32 %shr)
  %iv.next = add nuw nsw i32 %iv, 16
  %done = icmp eq i32 %iv.next, 520
  br i1 %done, label %exit, label %loop

exit:
  ret void
}

; %iv = 10*k + 14 is not divisible by 10, so exact is dropped when (%iv - 4)
; /u 10 is folded to %iv /u 10.
define void @drop_exact_udiv() {
; CHECK-LABEL: define void @drop_exact_udiv() {
; CHECK-NEXT:  [[ENTRY:.*]]:
; CHECK-NEXT:    br label %[[LOOP:.*]]
; CHECK:       [[LOOP]]:
; CHECK-NEXT:    [[IV:%.*]] = phi i32 [ 14, %[[ENTRY]] ], [ [[IV_NEXT:%.*]], %[[LOOP]] ]
; CHECK-NEXT:    [[DIV:%.*]] = udiv i32 [[IV]], 10
; CHECK-NEXT:    call void @use(i32 [[DIV]])
; CHECK-NEXT:    [[IV_NEXT]] = add nuw nsw i32 [[IV]], 10
; CHECK-NEXT:    [[DONE:%.*]] = icmp eq i32 [[IV_NEXT]], 334
; CHECK-NEXT:    br i1 [[DONE]], label %[[EXIT:.*]], label %[[LOOP]]
; CHECK:       [[EXIT]]:
; CHECK-NEXT:    ret void
;
entry:
  br label %loop

loop:
  %iv = phi i32 [ 14, %entry ], [ %iv.next, %loop ]
  %aligned = sub nuw nsw i32 %iv, 4
  %div = udiv exact i32 %aligned, 10
  call void @use(i32 %div)
  %iv.next = add nuw nsw i32 %iv, 10
  %done = icmp eq i32 %iv.next, 334
  br i1 %done, label %exit, label %loop

exit:
  ret void
}

; %iv = 10*k + 10 is divisible by 10, so exact is preserved when (%iv + 1) /u 10
; is folded to %iv /u 10.
define void @keep_exact_udiv() {
; CHECK-LABEL: define void @keep_exact_udiv() {
; CHECK-NEXT:  [[ENTRY:.*]]:
; CHECK-NEXT:    br label %[[LOOP:.*]]
; CHECK:       [[LOOP]]:
; CHECK-NEXT:    [[IV:%.*]] = phi i32 [ 10, %[[ENTRY]] ], [ [[IV_NEXT:%.*]], %[[LOOP]] ]
; CHECK-NEXT:    [[DIV:%.*]] = udiv exact i32 [[IV]], 10
; CHECK-NEXT:    call void @use(i32 [[DIV]])
; CHECK-NEXT:    [[IV_NEXT]] = add nuw nsw i32 [[IV]], 10
; CHECK-NEXT:    [[DONE:%.*]] = icmp eq i32 [[IV_NEXT]], 330
; CHECK-NEXT:    br i1 [[DONE]], label %[[EXIT:.*]], label %[[LOOP]]
; CHECK:       [[EXIT]]:
; CHECK-NEXT:    ret void
;
entry:
  br label %loop

loop:
  %iv = phi i32 [ 10, %entry ], [ %iv.next, %loop ]
  %unaligned = add nuw nsw i32 %iv, 1
  %div = udiv exact i32 %unaligned, 10
  call void @use(i32 %div)
  %iv.next = add nuw nsw i32 %iv, 10
  %done = icmp eq i32 %iv.next, 330
  br i1 %done, label %exit, label %loop

exit:
  ret void
}
